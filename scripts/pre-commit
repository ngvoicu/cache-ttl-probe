#!/bin/bash
# Blocks a commit when the files about to be committed hold a credential, a home-folder path or a pi session
# file, or when observed.json doesn't match the raw results. Install once per clone:
#     ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
# It checks the whole staged tree, so it doesn't matter how the files were added.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
git checkout-index -a --prefix="$tmp/"
python3 "$root/harness/scan_secrets.py" "$tmp"
(cd "$tmp" && python3 scripts/build_observed.py --check)
